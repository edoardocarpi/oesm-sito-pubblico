# Copia questo file in .env.local e inserisci i tuoi valori reali.
# Sono GLI STESSI valori usati nel CMS locale (stesso progetto Supabase).
# Qui pero' viene usata solo in lettura, grazie alle policy "lettura pubblica"
# gia' impostate quando abbiamo costruito il CMS.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-tua-anon-key-qui

# Indirizzo pubblico del sito quando sara' online (usato per SEO e sitemap).
# In locale puoi lasciare questo valore.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
